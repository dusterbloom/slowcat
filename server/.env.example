###############################################
# Slowcat Server — Surreal-first .env template #
###############################################

# Copy this file to server/.env and edit as needed.
# This is the single, canonical config. Older examples
# (.env.example.surreal, .env.surrealdb, env.example) are deprecated.

# ------------- Core -----------------
APP_PORT=7860
LLM_MODEL="qwen/qwen3-1.7b"
OPENAI_BASE_URL="http://localhost:1234/v1"
# Optional: fixed logical user id (empty = auto)
USER_ID=""

# ------------- Memory ----------------
# Choose memory backend: surreal | sqlite | stateless
MEMORY_BACKEND="surreal"

# SurrealDB connection (defaults work for local install)
SURREALDB_URL="ws://127.0.0.1:8000/rpc"
SURREALDB_NAMESPACE="slowcat"
SURREALDB_DATABASE="memory_graph"
SURREALDB_USER="root"
SURREALDB_PASS="slowcat_secure_2024"

# Optional: embed tape entries so semantic KNN works out of the box
SURREAL_EMBED_TAPE=true

# ------------- Behavior --------------
# Greeting:
#   pipeline = inject one greeting then suppress repeats
#   model    = let model greet itself
#   off      = never greet
GREETING_MODE="pipeline"

# Response formatting for TTS / links
#   off | minimal | full
RESPONSE_FORMATTER_MODE="off"

# MCP tool bridge (optional)
ENABLE_MCP=true

# ------------- STT/TTS ---------------
# STT backend: whisper-mlx | sherpa-onnx
STT_BACKEND=whisper-mlx
# If using Sherpa-ONNX, set model dir path (contains .onnx + tokens.txt)
# SHERPA_ONNX_MODEL_DIR=/absolute/path/to/sherpa-model

# ------------- Logging ---------------
LOG_LEVEL=info
STT_VERBOSE=false
TTS_VERBOSE=false

# ------------- Advanced --------------
# Most advanced toggles are now code defaults. Keep this section light.
# Flip only if you know you need them.
#SC_USE_ABSTRACT_SUMMARY=false
#SC_ENABLE_GRAPH_SCM=true
#ENABLE_SMART_TURN_MANAGEMENT=true
#PIPELINE_IDLE_TIMEOUT_SECS=0

# ------------- Tokens ----------------
# If using local LM Studio or Ollama with API key semantics, set this.
OPENAI_API_KEY="not-needed"

# Notes
# - SurrealDB graph memory is the default. No USE_SURREALDB flag required.
# - To switch: MEMORY_BACKEND=sqlite or stateless.
# - Keep env surface small; prefer defaults unless necessary.
