# Slowcat Essential Configuration
# Only the options users actually need to configure

# === CORE LLM SETTINGS ===
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://localhost:1234/v1
LLM_STREAMING=true

# === SPEECH & VOICE ===
STT_BACKEND=sherpa-onnx                 # Options: sherpa-onnx, whisper-mlx
TTS_ENGINE=kokoro                       # Options: kokoro, kitten, chatterbox
ENABLE_VOICE_RECOGNITION=false          # Speaker recognition and per-user memory

# === MEMORY & DATA ===
ENABLE_MEMORY=true                      # Conversation memory and facts
USER_ID=peppi                          # Your user identifier
ASSISTANT_ID=slowcat                   # Assistant identity

# === DATABASE (SurrealDB) ===
SURREALDB_URL=ws://127.0.0.1:8000/rpc
SURREALDB_USER=root  
SURREALDB_PASS=slowcat_secure_2024
SURREALDB_NAMESPACE=slowcat
SURREALDB_DATABASE=memory_graph

# === OPTIONAL FEATURES ===
ENABLE_MCP=false                       # Tool integration (web search, files, etc.)
ENABLE_VIDEO=false                     # Webcam integration
ENABLE_REFLECTIONS=false               # Background AI reflections

# === LANGUAGE & LOCALIZATION ===
SHERPA_LANGUAGE_LOCK=en               # Force specific language (en, es, fr, de, etc.)

# Advanced users only - uncomment to override defaults:
# LLM_CONTEXT_LENGTH=8192
# PIPELINE_IDLE_TIMEOUT_SECS=1800